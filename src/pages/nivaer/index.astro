---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import LevelCard from '../../components/LevelCard.astro';
import { nivaer } from '../../lib/nivaer';
import { kullar, sasongNamn } from '../../lib/sasong.mjs';

const ovningar = await getCollection('ovningar');
const sasong = sasongNamn();
const alla = kullar();
---

<Layout title="Nivåer">
	<Fragment slot="hero">
		<Hero labelledby="nivaer-title">
			<p class="eyebrow">Spelutbildning</p>
			<h1 id="nivaer-title"><span class="lvl-word-neutral">Nivåer</span></h1>
			<p class="hero-lead">Vi följer förbundets färger och nivånamn. Undertitlarna visar hur spelet växer: från bollen, till kompisen, till hela spelet.</p>
		</Hero>
	</Fragment>

	<ul class={`level-cards${nivaer.length > 3 ? ' level-cards-4' : ''}`}>
		{
			nivaer.map((n) => (
				<LevelCard
					niva={n.key}
					titel={n.namn}
					href={`/nivaer/${n.key}/`}
					knapp={`Gå till ${n.namn.toLowerCase()}`}
					rubrik="h2"
				>
					{n.undertitel} · {n.alder}
					<br />
					{ovningar.filter((o) => o.data.niva === n.key).length > 0 ? `${ovningar.filter((o) => o.data.niva === n.key).length} övningskort · ` : ''}{n.spelform}
				</LevelCard>
			))
		}
	</ul>

	<section aria-labelledby="kullar-title" class="kull-section">
		<h2 id="kullar-title">Rekommenderade kullar säsongen {sasong}</h2>
		<ul class={`kull-grid${nivaer.length > 3 ? ' kull-grid-4' : ''}`}>
			{
				nivaer.map((n) => (
					<li class={`card kull-group kull-${n.key}`}>
						<h3>{n.namn}</h3>
						<dl>
							{alla
								.filter((k) => k.id.startsWith(n.key))
								.map((k) => (
									<div>
										<dt>{k.division ? `Div ${k.division}: ` : ''}{k.id === 'ljusgron' ? 'Moälven Kidz' : k.etikett}</dt>
										<dd>{k.fodelsear}</dd>
									</div>
								))}
						</dl>
					</li>
				))
			}
		</ul>
		<p class="kull-notis">
			<Icon name="info" size={18} />
			<em>Födelseår per nivå och år på nivån. Det är en rekommendation, inte ett krav: förbundet beslutar efter ansökan vilken division laget får spela i. Årtalen räknas ut automatiskt och byts varje 1 juni.</em>
		</p>
	</section>
</Layout>
