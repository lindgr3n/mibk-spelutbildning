---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import { nivaer } from '../../lib/nivaer';
import { kullar, nivaFodelsear, sasongNamn } from '../../lib/sasong.mjs';

const ovningar = await getCollection('ovningar');
const sasong = sasongNamn();
const alla = kullar();
---

<Layout title="Nivåer">
	<Fragment slot="hero">
		<Hero labelledby="nivaer-title">
			<p class="eyebrow">Spelutbildning</p>
			<h1 id="nivaer-title"><span class="lvl-word-neutral">Nivåer</span></h1>
			<p class="hero-lead">Vi följer förbundets färger och nivånamn. Undertitlarna visar hur spelet växer: från bollen, till kompisen, till hela spelet.</p>
		</Hero>
	</Fragment>

	<ul class="level-cards">
		{
			nivaer.map((n) => (
				<li class={`level-card level-card-${n.key}`}>
					<Icon name="users" size={44} />
					<h2 class="level-card-title">{n.namn}</h2>
					<p>
						{n.undertitel} · {n.alder}
						<br />
						Rekommenderat: födda {nivaFodelsear(n.key)}
						<br />
						{n.spelform} · {ovningar.filter((o) => o.data.niva === n.key).length} övningskort
					</p>
					<a class="btn-white" href={`/nivaer/${n.key}/`}>
						Gå till {n.namn.toLowerCase()}
						<Icon name="arrow" size={20} />
					</a>
				</li>
			))
		}
	</ul>

	<section class="card panel" aria-labelledby="kullar-title">
		<div>
			<h2 id="kullar-title">Rekommenderade kullar säsongen {sasong}</h2>
			<p>Födelseår per nivå och år på nivån. Det är en rekommendation, inte ett krav: klubben avgör hur grupperna delas in. Årtalen räknas ut automatiskt och byts när en ny säsong börjar 1 juli.</p>
			<table>
				<thead>
					<tr><th>Nivå</th><th>År på nivån</th><th>Födda</th></tr>
				</thead>
				<tbody>
					{alla.map((k) => (
						<tr><td>{k.niva}</td><td>{k.etikett === k.niva ? '–' : k.etikett}</td><td>{k.fodelsear}</td></tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<div class="panel-row">
		<section class="card panel">
			<Icon name="users" size={56} />
			<div>
				<h2>Ljusgrön nivå (0–6 år)</h2>
				<p>Rekommenderat: födda {nivaFodelsear('ljusgron')}. Lek och rörelse. Inga matcher. Se uppstarten av nya lag och planens avsnitt om nivåerna.</p>
			</div>
			<a class="link-arrow" href="/nya-lag/">Starta ett nytt lag <Icon name="arrow" size={18} /></a>
		</section>
		<section class="card panel">
			<Icon name="users" size={56} />
			<div>
				<h2>Svart nivå (junior och senior)</h2>
				<p>Vi och spelet. Tränarmaterialet byggs ut senare.</p>
			</div>
			<a class="link-arrow" href="/plan/#3-nivåerna">Läs om nivåerna i planen <Icon name="arrow" size={18} /></a>
		</section>
	</div>
</Layout>
