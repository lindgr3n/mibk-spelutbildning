---
import { getEntry, render } from 'astro:content';
import DocPage from '../components/DocPage.astro';

const doc = (await getEntry('dokument', 'spelformsblad'))!;
const { Content, headings } = await render(doc);
---

<DocPage title={doc.data.titel} eyebrow="En sida per nivå" headings={headings} editPath="innehall/spelformsblad.md">
	<Content />
</DocPage>
