---
import { getEntry, render } from 'astro:content';
import DocPage from '../components/DocPage.astro';

const doc = (await getEntry('dokument', 'plan'))!;
const { Content, headings } = await render(doc);
---

<DocPage title={doc.data.titel} eyebrow="Moälvens IBK" headings={headings} editPath="innehall/plan.md">
	<Content />
</DocPage>
